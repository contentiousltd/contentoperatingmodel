---
// .c-topbar is the design system's chrome component. It is app chrome doing
// marketing duty here, which is what every other site in the suite does and
// what the COM reference page records as needing a marketing variant.
const links = [
  { href: '/framework', label: 'The framework' },
  { href: '/toolkit', label: 'The toolkit' },
  { href: '/changelog', label: 'Changelog' },
];
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
// astro:assets, as contentious.ltd: hashed WebP with a srcset, sized to the
// use. The mark renders at 1.67u, 33-40px, so 1x/2x/3x of 40.
import { Image } from 'astro:assets';
import apparatus from '../assets/com-apparatus.png';
---
<header class="c-marketing c-topbar">
  <a class="c-topbar__brand display-heading" href="/">
    <Image src={apparatus} alt="" widths={[40, 80, 120]} sizes="40px" loading="eager" decoding="async" />
    <span>Content Operating Model</span>
  </a>
  <nav class="c-topbar__right" aria-label="Main">
    {links.map((link) => (
      <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
  <button class="c-topbar__menu" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>
</header>

{/* Full-screen mobile nav, as contentious.ltd and contentmaturity.com, on
    Julius's call over the design system's sheet. See
    docs/design-deviations-2026-09-07.md item 20. */}
<div class="site-menu" id="site-menu" role="dialog" aria-modal="true" aria-label="Menu" aria-hidden="true">
  <button class="site-menu__x" type="button" aria-label="Close menu" data-menu-close>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>
  <nav class="site-menu__links" aria-label="Main">
    {links.map((link, n) => (
      <a
        class="site-menu__link"
        href={link.href}
        style={`--i: ${n}`}
        aria-current={path === link.href ? 'page' : undefined}
      >{link.label}</a>
    ))}
  </nav>
</div>

<script>
  const trigger = document.querySelector<HTMLButtonElement>('.c-topbar__menu');
  const host = document.getElementById('site-menu');
  if (trigger && host) {
    const setOpen = (open: boolean) => {
      host.classList.toggle('is-open', open);
      host.setAttribute('aria-hidden', String(!open));
      trigger.setAttribute('aria-expanded', String(open));
      document.body.classList.toggle('has-menu-open', open);
      if (open) host.querySelector<HTMLElement>('.site-menu__x')?.focus();
      else trigger.focus();
    };
    trigger.addEventListener('click', () => setOpen(!host.classList.contains('is-open')));
    host.querySelectorAll('[data-menu-close], .site-menu__link').forEach((el) =>
      el.addEventListener('click', () => setOpen(false)),
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && host.classList.contains('is-open')) setOpen(false);
    });
  }
</script>
