---
// .c-topbar is the design system's chrome component. It is app chrome doing
// marketing duty here, which is what every other site in the suite does and
// what the COM reference page records as needing a marketing variant
// (docs/design-deviations-2026-09-07.md item 25).
import { Image } from 'astro:assets';
// The apparatus in the sapling colourway, Julius's cut of 8 September 2026.
// The package's brand set still carries the earlier colourway
// (docs/optimisations-2026-09-07.md §7.8 asks for this one), so the mark is
// local until it does. layout="fixed" gives the element its real 40×40
// intrinsic size and a 1×/2× srcset.
import mark from '@/assets/apparatus-sapling.png';
import { NAV, SITE_NAME } from '@/config/site';
import { canonicalPath } from '@/lib/urls';

const path = canonicalPath(Astro.url.pathname);
const current = (href: string) => (path === href ? 'page' : undefined);
---
<header class="c-marketing c-topbar">
  <a class="c-topbar__brand display-heading" href="/">
    <Image src={mark} alt="" width={40} height={40} layout="fixed" loading="eager" />
    <span>{SITE_NAME}</span>
  </a>
  <nav class="c-topbar__right" aria-label="Main">
    {NAV.map((link) => (
      <a href={link.href} aria-current={current(link.href)}>{link.label}</a>
    ))}
  </nav>
  <button class="c-topbar__menu site-control" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu" data-menu-open>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>
</header>

{/* Full-screen mobile nav, as contentious.ltd and contentmaturity.com, on
    Julius's call over the design system's sheet (ledger item 20). A native
    <dialog>: showModal() gives the focus trap, Escape, the top layer and
    inertness of the page behind it, so the script only has to open, close
    and mirror the state onto the trigger. */}
<dialog class="c-marketing site-menu" id="site-menu" aria-label="Menu">
  <button class="site-menu__x site-control" type="button" aria-label="Close menu" data-menu-close>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>
  <nav class="site-menu__links" aria-label="Site">
    {NAV.map((link, n) => (
      <a class="site-menu__link" href={link.href} style={`--i: ${n}`} aria-current={current(link.href)}>{link.label}</a>
    ))}
  </nav>
</dialog>

<script>
  const trigger = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const menu = document.getElementById('site-menu') as HTMLDialogElement | null;
  if (trigger && menu) {
    const reflect = (open: boolean) => {
      trigger.setAttribute('aria-expanded', String(open));
      document.body.classList.toggle('has-menu-open', open);
    };
    trigger.addEventListener('click', () => {
      menu.showModal();
      reflect(true);
    });
    menu.querySelectorAll<HTMLElement>('[data-menu-close], .site-menu__link').forEach((el) =>
      el.addEventListener('click', () => menu.close()),
    );
    // Fires for close(), Escape and a link click alike.
    menu.addEventListener('close', () => {
      reflect(false);
      trigger.focus();
    });
    // If the viewport grows past the chrome breakpoint while the menu is open,
    // the desktop nav returns and the dialog would sit invisibly on top of it.
    matchMedia('(width >= 48rem)').addEventListener('change', (e) => {
      if (e.matches && menu.open) menu.close();
    });
  }
</script>
