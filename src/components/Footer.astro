---
// Descriptive cross-links to the family, as the June SEO audit asked of every
// sibling site. The lists come from src/config/site.ts, the same source as
// the header.
import { Image } from 'astro:assets';
import { FAMILY, FOOTER_NAV, PUBLISHER, SITE_NAME } from '@/config/site';
// The pale cut of the apparatus, sapling colourway, for the dark ground, as
// Content Health Check ships clipboard-pale for the same reason; the header
// keeps the full one. The package's brand set has no pale cut yet
// (docs/optimisations-2026-09-07.md §7.8), so this one is local. The mark
// renders at 4.8u, 96 to 116px.
import apparatus from '@/assets/apparatus-sapling-pale.png';
const year = new Date().getFullYear();
---
<footer class="c-marketing c-footer" data-surface="inverse">
  <div class="c-footer__in">
    {/* Mark as its own block beside the name and description, as
        voicetoneandstyle.com's footer, rather than inline with the wordmark
        at the system's 29px. See docs/design-deviations-2026-09-07.md 18. */}
    <div class="footer-brand">
      <Image src={apparatus} alt="" width={116} height={116} layout="fixed" loading="lazy" />
      <div>
        <p class="c-footer__brand">{SITE_NAME}</p>
        <p>An open framework from <a href={PUBLISHER.url}>{PUBLISHER.name}</a>, the content strategy practice.</p>
      </div>
    </div>
    <div class="c-footer__groups">
          <nav class="c-footer__group" aria-label="This site">
        <h4>Here</h4>
        <div class="c-footer__links">
          {FOOTER_NAV.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </nav>
      <nav class="c-footer__group" aria-label="Contentious products">
        <h4>Elsewhere</h4>
        <div class="c-footer__links">
          {FAMILY.map((site) => <a href={site.href}>{site.label}</a>)}
        </div>
      </nav>

    </div>
  </div>
  {/* A div, not a p, as in the reference page: .c-footer p sets margin and a
      46ch measure at higher specificity than .c-footer__legal, which would
      leave the legal line left-stuck and narrow (ledger item 6). */}
  <div class="c-footer__legal">&copy; {year} Contentious Ltd. The framework is free and stays free.</div>
</footer>
