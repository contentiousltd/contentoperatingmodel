---
// Descriptive cross-links to the family, as the June SEO audit asked of every
// sibling site. Anchor text says what the thing is, not "click here".
const year = new Date().getFullYear();
---
<footer class="c-footer">
  <div class="c-footer__inner">
    <div class="c-footer__brand">
      <img src="/images/com-apparatus.png" alt="" width="29" height="29" />
      <p class="display-heading">Content Operating Model</p>
      <p>An open framework from <a href="https://contentious.ltd">Contentious</a>, the content strategy practice.</p>
    </div>
    <nav class="c-footer__links" aria-label="Contentious products">
      <h2 class="display-heading">Elsewhere</h2>
      <ul>
        <li><a href="https://contentmaturity.com">Content maturity assessment</a></li>
        <li><a href="https://contenthealthcheck.com">Content audit tool</a></li>
        <li><a href="https://voicetoneandstyle.com">Voice, tone and style guide</a></li>
        <li><a href="https://contentious.ltd">Contentious</a></li>
      </ul>
    </nav>
    <nav class="c-footer__links" aria-label="This site">
      <h2 class="display-heading">This site</h2>
      <ul>
        <li><a href="/framework">The framework</a></li>
        <li><a href="/toolkit">The toolkit</a></li>
        <li><a href="/changelog">Changelog</a></li>
        <li><a href="/llms.txt">llms.txt</a></li>
      </ul>
    </nav>
  </div>
  <p class="c-footer__legal">&copy; {year} Contentious Ltd. The framework is free and stays free.</p>
</footer>
