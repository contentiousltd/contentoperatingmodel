---
/**
 * A marketing section for MDX prose: the design system's .c-marketing-section
 * with its column inside, and the prose in the system's long-form wrapper,
 * .c-reading (@contentious/ui's reading.css). The wrapper sits in the page
 * column, flush left on the page head's edge, and takes --reading-measure of
 * it. `tint` takes the alternating band. The Markdown twin unwraps it
 * (src/lib/mdx-to-markdown.ts), so it carries no meaning a machine needs,
 * only the page's rhythm.
 */
interface Props {
  tint?: boolean;
}
const { tint = false } = Astro.props;
---
<section class:list={['c-marketing', 'c-marketing-section', { 'c-marketing-section--tint': tint }]}>
  <div class="c-section__inner"><div class="c-reading"><slot /></div></div>
</section>
