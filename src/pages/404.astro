---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="That page does not exist." noindex>
  <section class="c-marketing c-marketing-section">
    <div class="c-section__inner">
      <h1 class="display-heading type-h1">Page not found</h1>
      <p class="type-intro">That page does not exist, or it moved.</p>
      <p><a href="/framework">The framework</a> is the thing most people are looking for.</p>
    </div>
  </section>
</BaseLayout>
