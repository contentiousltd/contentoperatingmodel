---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AccentList from '@/components/mdx/AccentList.astro';

const page = await getEntry('pages', 'toolkit');
if (!page) throw new Error('src/content/pages/toolkit.mdx is missing');
const { Content } = await render(page);
const { eyebrow, heading, intro } = page.data;
---
<BaseLayout
  title={page.data.title}
  metaTitle={page.data.metaTitle}
  description={page.data.description}
  markdownTwin="/toolkit.md"
  article
>
  <section class="c-marketing c-marketing-section prose">
    <div class="c-section__inner">
      {eyebrow && <p class="c-eyebrow">{eyebrow}</p>}
      <h1 class="page-title">{heading ?? page.data.title}</h1>
      {intro && <p class="page-lede">{intro}</p>}
      {/* Every list on this page is the design system's accent bullets. */}
      <Content components={{ ul: AccentList }} />
    </div>
  </section>
</BaseLayout>
