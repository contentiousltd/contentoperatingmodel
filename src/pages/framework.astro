---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { FRAMEWORK_VERSION, VOCABULARY } from '@/data/framework';
import { latestRelease, releaseDate } from '@/lib/releases';
import { SITE_URL } from '@/config/site';

const entry = await getEntry('framework', 'framework');
if (!entry) throw new Error('src/content/framework/framework.mdx is missing');
const { Content } = await render(entry);
const release = await latestRelease();

// The vocabulary as a DefinedTermSet: what makes the framework's terms citable
// as terms rather than as prose. See ADR-COM-0004.
const site = (Astro.site?.href ?? `${SITE_URL}/`).replace(/\/$/, '');
const jsonLd = [
  {
    '@type': 'DefinedTermSet',
    '@id': `${site}/framework#vocabulary`,
    name: 'Content Operating Model vocabulary',
    version: FRAMEWORK_VERSION,
    hasDefinedTerm: VOCABULARY.filter((term) => !term.rejected).map((term) => ({
      '@type': 'DefinedTerm',
      name: term.term,
      description: term.definition,
      inDefinedTermSet: `${site}/framework#vocabulary`,
    })),
  },
];
---
<BaseLayout
  title={entry.data.title}
  metaTitle={entry.data.metaTitle}
  description={entry.data.description}
  jsonLd={jsonLd}
  markdownTwin="/framework.md"
  article
  version={FRAMEWORK_VERSION}
>
  <article class="c-marketing">
    <section class="c-marketing-section page-head">
      <div class="c-section__inner">
        <p class="c-eyebrow">The framework</p>
        <h1 class="page-title">{entry.data.title}</h1>
        <p class="page-lede">
          Version {FRAMEWORK_VERSION}{release && <> · {releaseDate(release)}</>} · an open framework from
          Contentious, being tested with real organisations before 1.0.
        </p>
      </div>
    </section>

    {/* The body, in Bands, from framework.mdx. */}
    <Content />
  </article>
</BaseLayout>
