---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PAGES } from '@/config/site';
import { FRAMEWORK_VERSION } from '@/data/framework';
import { releases, releaseDateLong } from '@/lib/releases';
import { render } from 'astro:content';

const all = await releases();
const rendered = await Promise.all(all.map(async (release) => ({ release, Content: (await render(release)).Content })));
---
<BaseLayout
  title={PAGES.changelog.title}
  description={PAGES.changelog.description(FRAMEWORK_VERSION)}
  markdownTwin="/changelog.md"
  article
>
  <section class="c-marketing c-marketing-section prose">
    <div class="c-section__inner">
      <p class="c-eyebrow">{PAGES.changelog.eyebrow}</p>
      <h1 class="page-title">{PAGES.changelog.title}</h1>
      <p class="page-lede">{PAGES.changelog.intro}</p>
      {rendered.map(({ release, Content }) => (
        <article class="release">
          <h2 id={`v${release.data.version}`}>
            Version {release.data.version}
            <span class="meta">
              <time datetime={release.data.date.toISOString().slice(0, 10)}>{releaseDateLong(release)}</time>
            </span>
          </h2>
          <p>{release.data.summary}</p>
          <Content />
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
