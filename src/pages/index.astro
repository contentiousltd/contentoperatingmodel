---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { renderInline } from '@/lib/inline-markdown';
// Julius's pick over the apparatus for the hero; the header and footer marks
// stay on the apparatus. The largest thing above the fold, so eager and high
// priority. width is the slot's upper bound with the breakout (ledger 24):
// the constrained layout derives srcset and sizes from it.
import heroArt from '@/assets/com-2.png';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('src/content/pages/home.mdx is missing');
const { Content } = await render(home);
const { eyebrow, heading, intro, cta } = home.data;
const introHtml = intro ? await renderInline(intro) : undefined;
---
<BaseLayout
  title={home.data.title}
  metaTitle={home.data.metaTitle}
  description={home.data.description}
  markdownTwin="/index.md"
  article
>
  {/* .hero-band carries the ground and the 5rem padding maturitytool.com's
      hero sits in. Not .c-section: the design system's .c-section is the app
      spacer and adds a 2.33u margin-top, which showed as a strip of page
      ground under the topbar. See docs/design-deviations-2026-09-07.md
      item 10. */}
  <section class="c-marketing c-marketing-section hero-band">
    <div class="c-section__inner c-hero">
      <div>
        {eyebrow && <p class="c-eyebrow">{eyebrow}</p>}
        <h1 class="c-hero__title">{heading ?? home.data.title}</h1>
        {introHtml && <p class="c-hero__intro" set:html={introHtml} />}
        {cta && (
          <div class="c-hero__cta">
            <a class="c-button" href={cta.href}>{cta.label}</a>
          </div>
        )}
      </div>
      <div class="c-hero__art">
        <Image src={heroArt} alt="" width={800} loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <hr class="c-divider c-divider--taper" />

  <section class="c-marketing c-marketing-section prose">
    <div class="c-section__inner">
      <Content />
    </div>
  </section>
</BaseLayout>
