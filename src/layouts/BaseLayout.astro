---
import '@/styles/index.css';
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE_NAME, SITE_URL } from '@/config/site';
import { articleNode, buildJsonLd, type JsonLdNode } from '@/lib/structured-data';
import { canonicalPath } from '@/lib/urls';
import { datesForPath } from '@/lib/lastmod.mjs';
// The design system's base.css declares @font-face against the package's own
// font files, which Vite hashes into /_astro/. These resolve to the same
// asset the CSS references, in dev and in the build, so the preload and the
// stylesheet agree on one URL. Only the two faces every page paints above
// the fold; italic and bold load on demand.
import belyDisplayUrl from '@contentious/ui/fonts/BelyDisplay-Regular.woff2?url';
import belyRegularUrl from '@contentious/ui/fonts/Bely-Regular.woff2?url';

interface Props {
  title: string;
  /** Overrides the full <title>; otherwise "<title> | Content Operating Model". */
  metaTitle?: string;
  description: string;
  /** Extra JSON-LD nodes for this page, merged with Organization and WebSite. */
  jsonLd?: JsonLdNode[];
  /** Adds an Article node with the dates git knows for this route. */
  article?: boolean;
  /** The framework's version, carried on the Article node. */
  version?: string;
  noindex?: boolean;
  /** Path of this page's Markdown twin, e.g. /framework.md. */
  markdownTwin?: string;
}

const {
  title,
  metaTitle,
  description,
  jsonLd = [],
  article = false,
  version,
  noindex,
  markdownTwin,
} = Astro.props;

const pageTitle = metaTitle ?? `${title} | ${SITE_NAME}`;

// 'file' build format puts .html in Astro.url.pathname; the canonical URL is
// slash-free, extension-free, and "/" for the homepage. src/lib/urls.ts.
const path = canonicalPath(Astro.url.pathname);
const site = Astro.site ?? new URL(`${SITE_URL}/`);
const canonicalUrl = new URL(path, site).href;
const ogImage = new URL('/images/og-default.png', site).href;

const nodes: JsonLdNode[] = [...jsonLd];
if (article) {
  const dates = datesForPath(path);
  nodes.push(
    articleNode(site.href, {
      url: canonicalUrl,
      headline: title,
      description,
      published: dates.published,
      modified: dates.modified,
      version,
    }),
  );
}
const structuredData = buildJsonLd(site.href, nodes);
---

<!doctype html>
<html lang="en-GB" data-product="com">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {/* Client-side navigation with the browser's View Transitions API: the
      router fetches the next page, swaps the document and animates the
      change. Bundled scripts run once per session under it, so anything that
      wires up page elements listens for astro:page-load (see Header.astro). */}
  <ClientRouter />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonicalUrl} />

  {/* The machine door: every page's Markdown twin is discoverable from the
      page itself, not only from llms.txt. See ADR-COM-0004. */}
  {markdownTwin && (
    <link rel="alternate" type="text/markdown" href={new URL(markdownTwin, site).href} />
  )}

  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" href="/images/favicon-32.png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preload" href={belyDisplayUrl} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={belyRegularUrl} as="font" type="font/woff2" crossorigin />

  <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} releases`} href="/rss.xml" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
</body>
</html>
