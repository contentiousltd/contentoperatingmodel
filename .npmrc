# The shared @contentious packages are private, published to GitHub Packages as
# @contentiousltd/* (the registry only accepts the owning account as scope) and
# aliased back to @contentious/* in package.json, so imports don't change.
# The token is a classic PAT with read:packages only; set CONTENTIOUS_NPM_TOKEN
# in CI (a repo or org secret), on the Netlify site and in your shell. See
# the meta-repo's docs/plans/package-registry.md.
@contentiousltd:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${CONTENTIOUS_NPM_TOKEN}
