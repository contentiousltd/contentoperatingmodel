  "private": true,
  "description": "contentoperatingmodel.com — the Content Operating Model framework, toolkit and, later, the component library.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
