    "@contentious/ui": "github:contentiousltd/contentious-ui#v0.14.2",
    "astro": "^7.3.1",
    "mdast-util-to-string": "^4.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
