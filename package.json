{
  "name": "contentoperatingmodel",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "contentoperatingmodel.com — the Content Operating Model framework, toolkit and, later, the component library.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "build": "astro build",
    "postbuild": "node scripts/postbuild-validate.mjs",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "lint:prose": "node scripts/lint-prose.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:ui-current": "node scripts/check-ui-current.mjs",
    "lint": "npm run check && npm run lint:prose && npm run check:tokens"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@contentious/ui": "github:contentiousltd/contentious-ui#v0.14.2",
    "astro": "^7.3.1",
    "remark-smartypants": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3"
  }
}
