# MailerLite, for the email capture form (see docs/adr/adr-com-0004).
# The group id is the list new subscribers land in.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Dev only. Extra hostnames the dev server may be reached on, comma-separated,
# e.g. a machine's Tailscale MagicDNS name when previewing over SSH.
DEV_ALLOWED_HOSTS=
